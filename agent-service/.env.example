# The Node worker and private Python service share this dedicated secret.
PRISM_AGENT_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Explicit model: no silent provider/model fallback.
PRISM_AGENT_MODEL=
# Gemini 3: planner uses low; final defect review uses medium. provider opts out.
PRISM_AGENT_THINKING_LEVEL=medium
GEMINI_API_KEY=
# Optional JSON: model, asOf (YYYY-MM-DD), inputUsdPerMillion, outputUsdPerMillion.
# Leave blank unless you have verified the rates for the selected model.
PRISM_AGENT_PRICES_JSON=
